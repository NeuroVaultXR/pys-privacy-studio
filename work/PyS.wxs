    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="NVStart" Name="PyS - Privacy Studio">
        <Component Id="LinksProgramMenuFolder" Guid="*">
          <RegistryValue Root="HKCU" Key="Software\NeuroVaultXR\PrivacyStudio" Name="ProgramMenuFolder" Type="integer" Value="1" KeyPath="yes" />
          <Shortcut Id="LaunchProgramMenuFolder" Name="PyS - Privacy Studio" Target="[PYTHONDIR]pythonw.exe" Arguments="&quot;[INSTALLFOLDER]_internal\launch.pyw&quot;" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <Shortcut Id="Config" Name="Configura PyS - Privacy Studio" Target="[PYTHONDIR]pythonw.exe" Arguments="&quot;[INSTALLFOLDER]_internal\configure.pyw&quot;" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <RemoveFolder Id="RemoveMenu" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="LinksDesktopFolder" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\NeuroVaultXR\PrivacyStudio" Name="DesktopFolder" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="LaunchDesktopFolder" Name="PyS - Privacy Studio" Target="[PYTHONDIR]pythonw.exe" Arguments="&quot;[INSTALLFOLDER]_internal\launch.pyw&quot;" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      </Component>
    </StandardDirectory>
  </Package>
